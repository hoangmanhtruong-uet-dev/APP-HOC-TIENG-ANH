{
  "name": "ielts-self-study",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "scripts": {
    "dev": "next dev",
    "dev:remote": "node scripts/dev-remote.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:authenticated": "node scripts/run-e2e.mjs --require-authenticated",
    "test:e2e:remote-authenticated": "node scripts/run-remote-authenticated-e2e.mjs",
    "test:e2e:remote-authenticated:release": "node scripts/run-remote-authenticated-e2e.mjs --project=chromium-desktop --grep-invert @visual",
    "test:e2e:production-verification": "node scripts/run-e2e.mjs --require-authenticated",
    "test:e2e:raw": "playwright test",
    "test:visual": "node scripts/run-e2e.mjs --grep @visual",
    "test:visual:update": "node scripts/run-e2e.mjs --grep @visual --update-snapshots",
    "test:visual:remote-authenticated": "node scripts/run-remote-authenticated-e2e.mjs tests/e2e/screen-inventory.spec.ts --project=chromium-desktop",
    "test:visual:remote-authenticated:update": "node scripts/run-remote-authenticated-e2e.mjs tests/e2e/screen-inventory.spec.ts --project=chromium-desktop --update-snapshots",
    "test:e2e:cross-browser": "node scripts/run-remote-authenticated-e2e.mjs tests/e2e/cross-browser-smoke.spec.ts --project=chromium-desktop --project=firefox-smoke --project=webkit-smoke",
    "verify:ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:database": "node scripts/verify-database-release.mjs",
    "verify:remote-parity": "node scripts/verify-remote-migration-parity.mjs",
    "verify:screens": "node scripts/verify-screen-inventory.mjs",
    "verify:release": "npm run verify:database && npm run verify:screens && npm run verify:ci && npm run test:e2e && npm run test:visual && npm run test:e2e:remote-authenticated:release && npm run test:visual:remote-authenticated && npm run test:e2e:cross-browser"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.24.0",
    "music-metadata": "^11.14.0",
    "next": "^16.2.10",
    "openai": "^6.47.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "10.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
