# Public Supabase project values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxpakqsbltoezicapyti.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Keep false until the real domain owner confirms every related subdomain is
# HTTPS and intentionally eligible for browser preload lists.
ENABLE_HSTS_PRELOAD=false

# Keep server-only secrets out of NEXT_PUBLIC_* variables. The service-role key
# is used only by the authenticated retention cleanup route in production.

# Optional Phase 8 Writing feedback. Leave all provider variables unset for
# the safe disabled state. Partial configuration is reported as degraded and
# provider actions remain fail-closed; it does not make core readiness fail.
# Enabling Writing requires API key + explicit model + writing signing secret.
# Never prefix these with NEXT_PUBLIC_. The signing
# secret must match the Supabase Vault secret named writing_feedback_signing_secret.
OPENAI_API_KEY=
OPENAI_WRITING_MODEL=
WRITING_FEEDBACK_SIGNING_SECRET=

# Optional Phase 9 Speaking transcription and AI practice feedback. Leave the
# provider variables unset for the safe disabled/no-transcript/no-feedback
# fallback. Partial provider configuration is degraded and fail-closed.
# Enabling Speaking AI requires API key + both explicit models + the required
# Speaking signing secret.
# SPEAKING_PIPELINE_SIGNING_SECRET is still required in production upload flows,
# must be at least 32 characters and match the
# Supabase Vault secret named speaking_pipeline_signing_secret. These values
# are server-only and must never use the NEXT_PUBLIC_ prefix.
OPENAI_SPEAKING_TRANSCRIPTION_MODEL=
OPENAI_SPEAKING_FEEDBACK_MODEL=
SPEAKING_PIPELINE_SIGNING_SECRET=

# Required in production for the authenticated retention cleanup endpoint.
# Both values are server-only. Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_CLEANUP_SECRET=

# Optional account for authenticated Playwright tests. Never commit real values.
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=

# Optional fresh, verified account for the one-time onboarding E2E flow.
# The test skips if this account has already completed onboarding.
E2E_ONBOARDING_EMAIL=
E2E_ONBOARDING_PASSWORD=

# Shared completed-onboarding identities for authenticated owner-isolation E2E.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# Optional dedicated account for persisted learning-progress E2E.
E2E_LEARNING_EMAIL=
E2E_LEARNING_PASSWORD=

# Optional two completed-onboarding accounts for Phase 5 practice ownership E2E.
E2E_PRACTICE_USER_A_EMAIL=
E2E_PRACTICE_USER_A_PASSWORD=
E2E_PRACTICE_USER_B_EMAIL=
E2E_PRACTICE_USER_B_PASSWORD=

# Optional two completed-onboarding accounts for mock-test owner isolation.
E2E_MOCK_USER_A_EMAIL=
E2E_MOCK_USER_A_PASSWORD=
E2E_MOCK_USER_B_EMAIL=
E2E_MOCK_USER_B_PASSWORD=

# Required before any authenticated E2E mutation. Use the hosted project ref
# for remote Supabase; use "local" only when deliberately running the Docker stack.
E2E_EXPECTED_SUPABASE_PROJECT_REF=
